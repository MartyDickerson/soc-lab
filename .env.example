# ─────────────────────────────────────────────────
#  SOC Lab — Environment Config Template
#  Copy this to .env and fill in your values
#  NEVER commit .env to GitHub
# ─────────────────────────────────────────────────

# Wazuh Manager REST API (port 55000)
WAZUH_HOST=https://your-wazuh-server:55000
WAZUH_USER=wazuh
WAZUH_PASS=your-wazuh-api-password
WAZUH_VERIFY_SSL=false

# Wazuh Indexer / OpenSearch (port 9200)
WAZUH_INDEXER_HOST=https://your-wazuh-server:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=your-indexer-password
WAZUH_INDEXER_INDEX=wazuh-alerts-*

# Minimum rule.level to include (0–15)
# 0=all, 4=medium+, 7=medium-high+, 10=high+, 12=critical
MIN_SEVERITY=7

# VirusTotal (optional — free tier 4 req/min)
# Get key at: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB (optional — free tier 1000 req/day)
# Get key at: https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=

# Splunk HEC (for wazuh_to_splunk.py)
SPLUNK_HEC_URL=http://your-splunk-server:8088/services/collector/event
SPLUNK_HEC_TOKEN=your-hec-token
